<?xml version="1.0" encoding="UTF-8"?>
<!-- Adds a "Kitsu" shelf tab with two buttons — the closest Houdini
     equivalent of the Maya version's "Kitsu/Zou" menu:
       - "Kitsu" docks the panel as a pane tab in whichever pane the button
         was clicked from, or just refocuses it if already open elsewhere.
         Deliberately NOT hou.ui.curDesktop().createFloatingPanel(...):
         that spawns a brand new top-level OS window, which is both not
         what a Pane Tab Type panel is expected to look like and was
         observed shoving the whole Houdini main window to a different
         screen position when invoked (worst over Remote Desktop).
         Also deliberately NOT toolutils.createOrShowPythonPanel(), even
         though it looks like the obvious SideFX-provided helper for this:
         when the tab already exists and isn't the pane's current tab, it
         calls its own recursiveShowPane(), which does
         pane.setIsSplitMaximized(True) up the ENTIRE parent-split chain,
         a full-screen takeover of the whole desktop (shelf and all other
         panes included) that's only appropriate for a tool meant to
         dominate the screen when reopened (e.g. Render Gallery), not a
         panel meant to sit peacefully alongside the viewport. The panel
         is also always reachable via the "+" New Pane Tab Type menu of
         any pane, since it's a registered Python Panel interface — see
         python_panels/kitsu_houdini_plugin.pypanel.
         Note kwargs["pane"] below is ALWAYS None for a shelf-launched
         tool (per toolutils.activePane()'s own docstring: it's only ever
         set when a tool is launched from a Tab menu instead), so this
         cannot just check kwargs["pane"] and fall back to floating, or
         every shelf click would float. Instead it also tries the pane
         tab under the cursor, then falls back to the first pane on the
         current desktop (always present in any real layout) before ever
         resorting to a floating tab.
       - "Publish Capture" exports a full-scene H.264 MP4 of the current
         playback range and publishes it to Kitsu as a new revision,
         reusing the open panel's already-resolved login/task state. -->
<shelfDocument>
  <toolshelf name="kitsu_houdini_plugin" label="Kitsu">
    <memberTool name="kitsu_open_panel"/>
    <memberTool name="kitsu_publish_capture"/>
  </toolshelf>

  <tool name="kitsu_open_panel" label="Kitsu" icon="kitsu_houdini_plugin">
    <helpText>Open the Kitsu panel</helpText>
    <script scriptType="python"><![CDATA[
import hou

_INTERFACE_NAME = "kitsu_houdini_plugin"
pytype = hou.pypanel.interfaces()[_INTERFACE_NAME]

existing = None
for tab in hou.ui.paneTabs():
    if tab.type() == hou.paneTabType.PythonPanel and tab.activeInterface() == pytype:
        existing = tab
        break

if existing is not None:
    # Bring the existing tab to the front of its pane -- deliberately NOT
    # recursiveShowPane()/setIsSplitMaximized(), see the top-of-file note.
    existing.setIsCurrentTab()
else:
    # kwargs["pane"] is always None for a shelf click (see top-of-file
    # note), so find a real dockable pane ourselves instead of falling
    # straight to a floating tab.
    target_pane = None

    source_tab = kwargs.get("pane")
    if source_tab is not None:
        target_pane = source_tab.pane()

    if target_pane is None:
        under_cursor = hou.ui.paneTabUnderCursor()
        if under_cursor is not None:
            target_pane = under_cursor.pane()

    if target_pane is None:
        panes = hou.ui.curDesktop().panes()
        if panes:
            target_pane = panes[0]

    if target_pane is not None:
        new_tab = target_pane.createTab(hou.paneTabType.PythonPanel)
    else:
        new_tab = hou.ui.curDesktop().createFloatingPaneTab(hou.paneTabType.PythonPanel)
        if new_tab.floatingPanel():
            new_tab.floatingPanel().setName("Kitsu")
    new_tab.setActiveInterface(pytype)
]]></script>
  </tool>

  <tool name="kitsu_publish_capture" label="Publish Capture" icon="kitsu_houdini_plugin">
    <helpText>Export a full-scene video capture and publish it to Kitsu as a new revision</helpText>
    <script scriptType="python"><![CDATA[
import hou

from kitsu_houdini_plugin import panel, publish_capture

active_panel = panel.get_active_panel()
try:
    publish_capture.ensure_ready(active_panel)
except publish_capture.PublishCaptureError as exc:
    hou.ui.displayMessage(str(exc), title="Kitsu")
else:
    try:
        statuses = active_panel.session.all_task_statuses(active_panel.project)
    except Exception as exc:
        hou.ui.displayMessage(f"Could not load task statuses: {exc}", title="Kitsu")
    else:
        from kitsu_houdini_plugin.capture_dialog import prompt_for_status_and_comment

        prompted = prompt_for_status_and_comment(statuses, parent=hou.qt.mainWindow())
        if prompted is not None:
            task_status, comment = prompted
            try:
                output_path = publish_capture.run(active_panel, task_status, comment)
            except publish_capture.PublishCaptureError as exc:
                hou.ui.displayMessage(str(exc), title="Kitsu")
            except Exception as exc:
                hou.ui.displayMessage(f"Capture export failed: {exc}", title="Kitsu")
            else:
                hou.ui.displayMessage(
                    f"Capture published to Kitsu and saved to:\n{output_path}",
                    title="Kitsu",
                )
]]></script>
  </tool>
</shelfDocument>
